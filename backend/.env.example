# Server
NODE_ENV=development
PORT=5000

# PostgreSQL — paste your connection string here
DATABASE_URL=postgresql://user:password@host:5432/bytevox

# JWT — generate a long random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# File upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:5173
