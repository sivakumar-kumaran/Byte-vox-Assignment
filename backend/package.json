{
  "name": "bytevox-backend",
  "version": "1.0.0",
  "description": "ByteVox Show-Your-Work Report Builder — Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
